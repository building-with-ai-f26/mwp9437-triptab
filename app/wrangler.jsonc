{
  // TripTab on Cloudflare Workers (Build 3, Advanced lane). Static files only: no Worker code runs.
  // Cloudflare's Workers Builds runs app/scripts/cloudflare-build.sh (the tests, then the build into
  // dist/) and deploys main to triptab.org only once the tests pass; other branches get a Preview.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triptab",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    // The app picks the screen in the browser (react-router), so a path that isn't a file, like
    // /join/abc or /trips/123, gets index.html instead of a 404.
    "not_found_handling": "single-page-application"
  },
  // Production lives on the domain only. Pull request Previews get their own workers.dev address,
  // built against TripTab dev, so a Preview never touches real users.
  "routes": [{ "pattern": "triptab.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  // Workers Builds deploys a branch with `wrangler preview`, which won't run without this block. It
  // stays empty: assets and compatibility settings above apply to Previews too.
  "previews": {}
}
