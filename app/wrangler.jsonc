{
  // TripTab on Cloudflare Workers (Build 3, Advanced lane). Static files only: no Worker code runs.
  // `npm run build` writes the app to dist/; GitHub Actions (.github/workflows/ci.yml) deploys it to
  // triptab.org on every merge to main once the tests pass, and gives each pull request a Preview.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triptab",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    // The app picks the screen in the browser (react-router), so a path that isn't a file, like
    // /join/abc or /trips/123, gets index.html instead of a 404.
    "not_found_handling": "single-page-application"
  },
  // Production lives on the domain only. Pull request Previews get their own workers.dev address,
  // built against TripTab dev, so a Preview never touches real users.
  "routes": [{ "pattern": "triptab.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true
}
