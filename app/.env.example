# Copy to app/.env.local (git ignores it). All values here are public by design: they ship in the
# browser, and row-level security decides what anyone can do. Never put a secret in a VITE_ variable.
#
# Local runs, tests and evals use TripTab dev (the second Supabase project, Build 3), so they never
# touch real users. Production's values live only in app/scripts/cloudflare-build.sh, which builds
# what Cloudflare deploys to triptab.org. PostHog stays off locally; e2e/posthog-check.cjs passes its own dummy key.
VITE_SUPABASE_URL=https://iivseqkvixmvcpldarqy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_wXWIUwViR_2h7G1VsubAkA_eTKSWSgJ
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
